generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum ConversationType {
  DIRECT
  GROUP

  @@map("conversation_type")
}

enum MemberRole {
  MEMBER
  ADMIN
  OWNER

  @@map("member_role")
}

enum MessageKind {
  TEXT
  MEDIA

  @@map("message_kind")
}

enum MediaPurpose {
  AVATAR
  MESSAGE_ATTACHMENT

  @@map("media_purpose")
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
  CANCELLED

  @@map("media_status")
}

enum AttachmentKind {
  IMAGE
  PDF

  @@map("attachment_kind")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique(map: "users_email_key") @db.VarChar(320)
  username      String     @unique(map: "users_username_key") @db.VarChar(32)
  displayName   String     @map("display_name") @db.VarChar(80)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  avatarUrl     String?    @map("avatar_url") @db.Text
  avatarAssetId String?    @unique(map: "users_avatar_asset_id_key") @map("avatar_asset_id") @db.Uuid
  status        UserStatus @default(ACTIVE)
  lastSeenAt    DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  createdConversations Conversation[]       @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messages             Message[]
  messageReads         MessageRead[]
  authSessions         AuthSession[]
  ownedMediaAssets     MediaAsset[]         @relation("MediaAssetOwner")
  avatarAsset          MediaAsset?          @relation("CurrentAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("users")
}

model MediaAsset {
  id                  String       @id @default(uuid()) @db.Uuid
  ownerId             String       @map("owner_id") @db.Uuid
  purpose             MediaPurpose @default(AVATAR)
  status              MediaStatus  @default(PENDING)
  declaredContentType String       @map("declared_content_type") @db.VarChar(64)
  declaredSize        Int          @map("declared_size")
  detectedContentType String?      @map("detected_content_type") @db.VarChar(64)
  actualSize          Int?         @map("actual_size")
  width               Int?
  height              Int?
  incomingObjectKey   String?      @unique(map: "media_assets_incoming_object_key_key") @map("incoming_object_key") @db.Text
  readyObjectKey      String?      @unique(map: "media_assets_ready_object_key_key") @map("ready_object_key") @db.Text
  publicUrl           String?      @unique(map: "media_assets_public_url_key") @map("public_url") @db.Text
  uploadExpiresAt     DateTime     @map("upload_expires_at") @db.Timestamptz(3)
  readyAt             DateTime?    @map("ready_at") @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner             User               @relation("MediaAssetOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  avatarFor         User?              @relation("CurrentAvatar")
  messageAttachment MessageAttachment?

  @@index([ownerId, purpose, status, createdAt], map: "media_assets_owner_id_purpose_status_created_at_idx")
  @@index([status, uploadExpiresAt], map: "media_assets_status_upload_expires_at_idx")
  @@map("media_assets")
}

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  type          ConversationType @default(DIRECT)
  directKey     String?          @unique(map: "conversations_direct_key_key") @map("direct_key") @db.VarChar(73)
  title         String?          @db.VarChar(120)
  createdById   String?          @map("created_by_id") @db.Uuid
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy          User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  members            ConversationMember[]
  messages           Message[]
  messageReads       MessageRead[]
  messageAttachments MessageAttachment[]

  @@index([createdById], map: "conversations_created_by_id_idx")
  @@map("conversations")
}

model ConversationMember {
  conversationId String     @map("conversation_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?  @map("left_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([conversationId, userId], map: "conversation_members_pkey")
  @@index([userId, leftAt, conversationId], map: "conversation_members_user_id_left_at_conversation_id_idx")
  @@map("conversation_members")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  clientMessageId String      @map("client_message_id") @db.Uuid
  kind            MessageKind @default(TEXT)
  body            String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt        DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)

  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  readWatermarks MessageRead[]
  attachments    MessageAttachment[]

  @@unique([senderId, clientMessageId], map: "messages_sender_id_client_message_id_key")
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "messages_conversation_id_created_at_id_idx")
  @@map("messages")
}

model MessageAttachment {
  id                 String    @id @default(uuid()) @db.Uuid
  assetId            String    @unique(map: "message_attachments_asset_id_key") @map("asset_id") @db.Uuid
  conversationId     String    @map("conversation_id") @db.Uuid
  messageId          String?   @map("message_id") @db.Uuid
  originalFileName   String    @map("original_file_name") @db.Text
  kind               AttachmentKind
  position           Int       @default(0)
  thumbnailObjectKey String?   @unique(map: "message_attachments_thumbnail_object_key_key") @map("thumbnail_object_key") @db.Text
  purgeAfter         DateTime? @map("purge_after") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset        MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([messageId, position], map: "message_attachments_message_id_position_key")
  @@index([conversationId, messageId], map: "message_attachments_conversation_id_message_id_idx")
  @@index([purgeAfter], map: "message_attachments_purge_after_idx")
  @@map("message_attachments")
}

/// Per-user read watermark. Application updates must only advance it in
/// `(messages.created_at, messages.id)` order within the same conversation.
model MessageRead {
  conversationId    String   @map("conversation_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  lastReadMessageId String   @map("last_read_message_id") @db.Uuid
  readAt            DateTime @map("read_at") @db.Timestamptz(3)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastReadMessage Message      @relation(fields: [lastReadMessageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([conversationId, userId], map: "message_reads_pkey")
  @@index([userId], map: "message_reads_user_id_idx")
  @@index([lastReadMessageId], map: "message_reads_last_read_message_id_idx")
  @@map("message_reads")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Text
  userAgent        String?   @map("user_agent") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@map("auth_sessions")
}
