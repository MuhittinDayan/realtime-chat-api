NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat
FRONTEND_ORIGIN=http://chat.test:3000
# Replace this intentionally invalid placeholder with at least 32 random bytes.
JWT_ACCESS_SECRET=change-me
JWT_ISSUER=chat-api
JWT_AUDIENCE=chat-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000

# S3-compatible object storage (MinIO locally; S3/R2 in production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=chat-local-access
STORAGE_SECRET_ACCESS_KEY=chat-local-secret-key
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AVATAR_BUCKET=chat-avatars
STORAGE_ATTACHMENT_BUCKET=chat-attachments
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/chat-avatars
AVATAR_UPLOAD_URL_TTL_SECONDS=600
MEDIA_CLEANUP_INTERVAL_MS=900000
MEDIA_STALE_UPLOAD_AGE_MS=3600000
AVATAR_CACHE_CONTROL=public, max-age=86400
